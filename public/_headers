/*
  # Prevent clickjacking
  X-Frame-Options: DENY
  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff
  # Enforce HTTPS for 1 year, include sub-domains, allow preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Reduce referrer information leakage
  Referrer-Policy: strict-origin-when-cross-origin
  # Disable browser features not needed by this app
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Isolate browsing context to mitigate Spectre-class side-channel attacks
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Content Security Policy
  # - script-src: 'unsafe-inline' required for Astro is:inline scripts, Microsoft Clarity, CF Insights, and Monaco Editor CDN
  # - script-src/connect-src also allow Google Analytics (was blocked before Oct 2026) and Carbon Ads
  # - connect-src: Clarity telemetry, AppInsights, and CF Insights, plus https: so the
  #   JSON tools' "Load from URL" can fetch a URL the user types, straight from the browser
  # - img-src: data: URIs for generated gradients; https: for OG image previews
  # - worker-src: blob: required by Monaco Editor web workers
  # - font-src: jsdelivr for Monaco Editor codicon font
  # - frame-ancestors: blocks embedding in any cross-origin frame
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.clarity.ms https://scripts.clarity.ms https://static.cloudflareinsights.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://cdn.carbonads.com https://srv.carbonads.net; connect-src 'self' https: https://*.clarity.ms https://dc.services.visualstudio.com https://cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://srv.carbonads.net; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ── Browser Caching Rules for Maximum Performance ────────────

# 1. Astro's bundled JS/CSS (Safely cache for 1 year because filenames are hashed)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Brand Assets and Favicons (Cache for 1 month)
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 3. Web Manifest (Cache for 1 week to allow theme color updates)
/*.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# ── Keep the Cloudflare preview domain out of search results ──
# syntaxsnap.pages.dev and branch previews duplicate syntaxsnap.com
# (9 Clarity visits leaked there, Oct 2026).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
