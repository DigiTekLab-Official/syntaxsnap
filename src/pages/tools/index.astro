---
// src/pages/tools/index.astro — the full tool directory (/tools)
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ui/ToolCard.astro';
import { TOOLS, CATEGORY_NAV, TOOL_CATEGORIES, toolsIn } from '../../config/tools';
import { buildCollectionPage, buildBreadcrumbList, SITE_URL } from '../../utils/schema';

const title = `All ${TOOLS.length} Free Developer Tools | SyntaxSnap`;
const description = `Every SyntaxSnap tool in one place: JSON, schema and TypeScript converters, encoders, generators and CSS tools. ${TOOLS.length} free tools that run in your browser.`;
const collection = buildCollectionPage('All developer tools', description, `${SITE_URL}/tools`, TOOLS.map((t) => ({ name: t.title, url: `${SITE_URL}${t.href}` })));
const crumbs = buildBreadcrumbList([{ name: 'Home', url: SITE_URL }, { name: 'Developer Tools', url: `${SITE_URL}/tools` }]);
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(collection)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />

  <header class="mb-10 max-w-2xl">
    <h1 class="text-[32px] font-semibold tracking-tight text-white">All developer tools</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-slate-400">{TOOLS.length} tools, grouped by what you are working on. Press <kbd class="rounded border border-slate-700 bg-slate-800 px-1.5 font-mono text-xs">⌘K</kbd> on any page to jump straight to one.</p>
  </header>

  {CATEGORY_NAV.map(({ key, label }) => (
    <section class="mb-12" aria-labelledby={`cat-${key}`}>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-800 pb-2">
        <h2 id={`cat-${key}`} class="text-xl font-semibold text-white">{label}</h2>
        <a href={`/tools/category/${key}`} class="text-sm text-indigo-400 hover:text-indigo-300">{TOOL_CATEGORIES[key].subtitle}</a>
      </div>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {toolsIn(key).map((t) => <ToolCard tool={t} />)}
      </div>
    </section>
  ))}
</Layout>
