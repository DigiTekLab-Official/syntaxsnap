---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import HeroDemo from '../components/tools/HeroDemo';
import { TOOLS, CATEGORY_NAV, FEATURED_TOOL_IDS, toolsIn, toolById, shortName } from '../config/tools';
import { HIRE_URL } from '../config/site';

const featured = FEATURED_TOOL_IDS.map((id) => toolById(id)).filter((t) => t !== undefined);
const localCount = TOOLS.filter((t) => !t.network).length;
import { buildWebApplication, buildItemList, SITE_URL } from '../utils/schema';

// SEO: WebApplication — establishes SyntaxSnap as a platform
const webAppSchema = buildWebApplication();

// SEO: ItemList — helps Google understand the full tool inventory
const itemListSchema = buildItemList(
  TOOLS.map(t => ({ name: t.title, url: `${SITE_URL}${t.href}` }))
);

// ── Triple-Lock Branding Schemas ────────────────────────────────
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SyntaxSnap",
  "alternateName": ["Syntax Snap", "DigiTekLab SyntaxSnap"],
  "url": "https://syntaxsnap.com/"
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SyntaxSnap",
  "url": "https://syntaxsnap.com/",
  "logo": {
    "@type": "ImageObject",
    "url": "https://syntaxsnap.com/logo.png",
    "width": 512,
    "height": 512
  }
};
---

<Layout
  title="SyntaxSnap – Free Private Developer Tools: CSS Gradients, OpenAPI to Zod, SQL to Prisma"
  description={`Design CSS gradients and shadows visually, and turn OpenAPI, SQL and JSON into Zod, Prisma, Drizzle and TypeScript. ${TOOLS.length} free developer tools that run in your browser.`}
  isHomepage={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="grid items-center gap-10 pb-16 pt-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-14">
    <div>
      <h1 class="max-w-[16ch] text-[40px] font-semibold leading-[1.08] tracking-[-0.025em] text-white md:text-[52px]">
        Developer tools that never see your data.
      </h1>
      <p class="mt-5 max-w-[46ch] text-[17px] leading-relaxed text-slate-400">
        Turn OpenAPI specs, SQL tables and JSON into Zod, Prisma and TypeScript, and design gradients and shadows you can see. Everything runs in your browser tab, so production data stays on your machine.
      </p>

      <button type="button" class="cmd-palette-trigger mt-8 flex h-12 w-full max-w-md items-center gap-3 rounded-lg border border-slate-700 bg-slate-900 px-4 text-left text-[15px] text-slate-400 transition-colors hover:border-indigo-500/70 hover:text-slate-200">
        <svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
        <span class="flex-1">Find a tool, like "jwt" or "json to ts"</span>
        <kbd class="hidden rounded border border-slate-700 bg-slate-800 px-1.5 py-px font-mono text-xs sm:inline">⌘K</kbd>
      </button>

      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href="/json" class="font-medium text-indigo-400 hover:text-indigo-300">JSON tools</a>
        <a href="/tools/openapi-to-zod" class="font-medium text-indigo-400 hover:text-indigo-300">OpenAPI to Zod</a>
        <a href="/tools/aurora-gradient" class="font-medium text-indigo-400 hover:text-indigo-300">Aurora gradient generator</a>
        <a href="/tools/sql-to-prisma" class="font-medium text-indigo-400 hover:text-indigo-300">SQL to Prisma</a>
      </div>
    </div>

    <HeroDemo client:load />
  </section>

  <section aria-labelledby="start" class="border-t border-slate-800 py-12">
    <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="start" class="text-2xl font-semibold tracking-tight text-white">Most used</h2>
      <a href="/tools" class="text-sm text-indigo-400 hover:text-indigo-300">Browse all {TOOLS.length} tools</a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((t) => <ToolCard tool={t!} />)}
    </div>
  </section>

  <section aria-labelledby="all-tools-h" id="all-tools" class="border-t border-slate-800 py-12">
    <h2 id="all-tools-h" class="mb-8 text-2xl font-semibold tracking-tight text-white">Every tool, by what you are working on</h2>
    <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORY_NAV.map(({ key, label }) => (
        <div>
          <h3 class="mb-3 flex items-baseline justify-between border-b border-slate-800 pb-2">
            <a href={`/tools/category/${key}`} class="text-[15px] font-medium text-slate-100 hover:text-indigo-300">{label}</a>
            <span class="text-xs tabular-nums text-slate-500">{toolsIn(key).length}</span>
          </h3>
          <ul class="space-y-0.5">
            {toolsIn(key).map((t) => {
              const Icon = t.icon;
              return (
                <li>
                  <a href={t.href} class="-mx-2 flex items-center gap-2.5 rounded px-2 py-1.5 text-sm text-slate-400 hover:bg-slate-900 hover:text-slate-100">
                    <Icon class={`h-4 w-4 shrink-0 ${t.color}`} aria-hidden="true" />
                    <span class="truncate">{shortName(t)}</span>
                    {t.status === 'New' && <span class="text-[11px] text-indigo-400">new</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="privacy-h" class="border-t border-slate-800 py-12">
    <h2 id="privacy-h" class="max-w-[24ch] text-2xl font-semibold tracking-tight text-white">Safe to paste production data</h2>
    <div class="mt-6 grid gap-8 md:grid-cols-3">
      <div>
        <h3 class="text-[15px] font-medium text-slate-100">The work happens in your tab</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">{localCount} of {TOOLS.length} tools are plain JavaScript running on your device. There is no server receiving your JSON, tokens or schemas.</p>
      </div>
      <div>
        <h3 class="text-[15px] font-medium text-slate-100">You can check it yourself</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">Open your browser's network tab and use any tool. Converting and generating make no requests to a server.</p>
      </div>
      <div>
        <h3 class="text-[15px] font-medium text-slate-100">The one exception is labelled</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">The AI Mock Generator sends your prompt to OpenAI to write the data. Its status bar says so, and it never sees anything else you paste.</p>
      </div>
    </div>
  </section>

  <section class="grid gap-4 border-t border-slate-800 py-12 md:grid-cols-2">
    <div class="rounded-lg border border-slate-800 bg-ws-panel p-6">
      <h2 class="text-lg font-semibold text-white">Design tools you can see</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">Tune aurora and mesh gradients, glass panels and layered shadows with a live preview, then copy plain CSS or Tailwind classes.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/tools/aurora-gradient" class="inline-flex rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-indigo-400">Open Aurora Gradient</a>
        <a href="/tools/category/css" class="inline-flex rounded-md px-2 py-2 text-sm font-medium text-indigo-400 hover:text-indigo-300">All CSS tools</a>
      </div>
    </div>
    <div class="rounded-lg border border-slate-800 bg-ws-panel p-6">
      <h2 class="text-lg font-semibold text-white">Building for developers?</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">Have the SyntaxSnap team build a custom code generator or internal tool for your stack, or sponsor a tool your audience already uses.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={HIRE_URL} target="_blank" rel="noopener" class="inline-flex rounded-md border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 hover:border-slate-500 hover:text-white">Hire Digitek Lab</a>
        <a href="/sponsor" class="inline-flex rounded-md px-2 py-2 text-sm font-medium text-indigo-400 hover:text-indigo-300">Sponsor SyntaxSnap</a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-800 py-12">
    <div class="prose-ws">
      <h2 class="!mt-0">Free online developer tools without the upload</h2>
      <p>Most online formatters and converters send what you paste to a server. SyntaxSnap is a collection of {TOOLS.length} free developer utilities that run in your browser instead: a <a href="/tools/json-formatter">JSON formatter and validator</a>, <a href="/tools/json-to-typescript">JSON to TypeScript</a> and <a href="/tools/json-to-zod">JSON to Zod</a> converters, a <a href="/tools/jwt-debugger">JWT decoder</a>, <a href="/tools/regex-tester">regex tester</a>, <a href="/tools/base64">Base64</a> and <a href="/tools/url-encoder">URL encoders</a>, schema converters for OpenAPI, GraphQL, Prisma and SQL, and CSS generators for gradients, shadows and glassmorphism.</p>
    </div>
  </section>
</Layout>
