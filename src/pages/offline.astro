---
// src/pages/offline.astro — self-hosting for teams (on request).
// Earlier copy claimed SOC2/HIPAA suitability, a Docker image and performance
// figures that the repo does not back up (no Dockerfile, no licence file).
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, HIRE_URL } from '../config/site';

const title = 'Self-Hosting SyntaxSnap for Teams | SyntaxSnap';
const description = 'Run the SyntaxSnap developer tools on your own network. Available to teams on request, including custom tools built for your stack.';
const mail = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('SyntaxSnap self-hosting')}`;
---

<Layout title={title} description={description}>
  <div class="max-w-3xl">
    <h1 class="text-[32px] font-semibold tracking-tight text-white">Self-hosting for teams</h1>
    <p class="mt-3 text-[16px] leading-relaxed text-slate-400">
      SyntaxSnap's converters and generators are a static site that runs in the browser, so they can be served from inside your own network. We set this up for teams on request.
    </p>
  </div>

  <section class="prose-ws mt-10">
    <h2>What you get</h2>
    <p>A build of the SyntaxSnap tools your team chooses, served from your own domain or intranet, such as <code>tools.yourcompany.com</code>. The tools work the same way as on syntaxsnap.com: input is processed in each user's browser.</p>
    <p>The AI Mock Generator is the exception. It needs an OpenAI API key and sends prompts to OpenAI, so it is left out of self-hosted builds unless you ask for it.</p>

    <h2>Custom tools</h2>
    <p>If your team converts between internal formats, such as a proprietary schema to TypeScript or an internal API spec to client code, the Digitek Lab team that builds SyntaxSnap can add a converter for it.</p>

    <h2>How to ask</h2>
    <p>Email <a href={mail}>{CONTACT_EMAIL}</a> with the tools you need and where they will be hosted. We will reply with what is involved and a quote.</p>
  </section>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href={mail} class="inline-flex rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-indigo-400">Email about self-hosting</a>
    <a href={HIRE_URL} target="_blank" rel="noopener" class="inline-flex rounded-md border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 hover:border-slate-500 hover:text-white">About Digitek Lab</a>
  </div>
</Layout>
