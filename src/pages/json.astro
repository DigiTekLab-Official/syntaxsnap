---
// src/pages/json.astro — JSON Hub: every JSON tool, grouped by task (/json).
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import { JSON_HUB_GROUPS, toolById, type Tool } from '../config/tools';
import { buildCollectionPage, buildBreadcrumbList, SITE_URL } from '../utils/schema';

const groups = JSON_HUB_GROUPS.map((g) => ({ ...g, tools: g.ids.map(toolById).filter((t): t is Tool => Boolean(t)) }));
const all = groups.flatMap((g) => g.tools);

const title = "JSON Tools Online – Free, Private, No Upload | SyntaxSnap";
const description = `Format, view, validate, minify, compare and convert JSON to CSV, YAML, XML and TypeScript. ${all.length} free JSON tools that run in your browser, with no upload.`;
const collection = buildCollectionPage('JSON tools', description, `${SITE_URL}/json`, all.map((t) => ({ name: t.title, url: `${SITE_URL}${t.href}` })));
const crumbs = buildBreadcrumbList([{ name: 'Home', url: SITE_URL }, { name: 'JSON Tools', url: `${SITE_URL}/json` }]);
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(collection)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbs)} />

  <Fragment slot="breadcrumb">
    <a href="/" class="hover:text-slate-200">Home</a>
    <span aria-hidden="true">/</span>
    <span class="text-slate-300" aria-current="page">JSON tools</span>
  </Fragment>

  <header class="mb-10 max-w-2xl">
    <h1 class="text-[32px] font-semibold tracking-tight text-white md:text-[40px]">JSON Tools Online</h1>
    <p class="mt-3 text-[16px] leading-relaxed text-slate-400">
      Everything you need to work with JSON: format and explore it, find every error, compare two versions, and convert it to and from CSV, YAML, XML and TypeScript. Every tool runs in your browser, so the data you paste never leaves your device.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="/tools/json-formatter" class="inline-flex rounded-md bg-indigo-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-indigo-400">Open the JSON formatter</a>
      <a href="/tools/json-validator" class="inline-flex rounded-md border border-slate-700 px-4 py-2 text-sm font-medium text-slate-200 hover:border-slate-500 hover:text-white">Validate JSON</a>
    </div>
  </header>

  {groups.map((g) => (
    <section class="mb-12" aria-labelledby={`g-${g.title}`}>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-800 pb-2">
        <h2 id={`g-${g.title}`} class="text-xl font-semibold text-white">{g.title}</h2>
        <p class="text-sm text-slate-400">{g.blurb}</p>
      </div>
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {g.tools.map((t) => <ToolCard tool={t} />)}
      </div>
    </section>
  ))}

  <section class="border-t border-slate-800 pt-10">
    <div class="prose-ws">
      <h2 class="!mt-0">One engine, no uploads</h2>
      <p>All of these tools share the same JSON engine. It reports errors with the exact line and column, accepts JSON with comments when you ask it to, repairs the almost-JSON that LLMs and config files produce, and moves files over 1 MB to a background thread so the page never freezes. Files are read from your disk with the browser's FileReader, and the URL loader fetches straight from your browser to the address you type. Nothing passes through a SyntaxSnap server.</p>
      <p>Most tools hand their result to the next one. Format an API response, send it to <a href="/tools/json-to-typescript">JSON to TypeScript</a> or <a href="/tools/json-to-zod">JSON to Zod</a>, or turn it into a spreadsheet with <a href="/tools/json-to-csv">JSON to CSV</a>, without copying and pasting between tabs.</p>
    </div>
  </section>
</Layout>
