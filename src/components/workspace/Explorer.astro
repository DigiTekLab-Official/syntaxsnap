---
// src/components/workspace/Explorer.astro
// IDE-style tool tree. Categories are folders, tools are files.
import { CATEGORY_NAV, toolsIn, shortName, type Tool } from '../../config/tools';
import { HIRE_URL } from '../../config/site';
import AdSlot from './AdSlot.astro';

interface Props { current?: Tool }
const { current } = Astro.props;
---

<nav class="ws-explorer flex h-full flex-col" aria-label="All tools">
  <div class="flex-1 overflow-y-auto px-2 py-3">
    {CATEGORY_NAV.map(({ key, label }) => {
      const items = toolsIn(key);
      const open = !current || current.category === key || key === 'json';
      return (
        <details open={open} class="group mb-1">
          <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded px-2 py-1.5 text-[13px] font-medium text-slate-300 hover:bg-slate-900 [&::-webkit-details-marker]:hidden">
            <svg class="h-3 w-3 shrink-0 text-slate-500 transition-transform group-open:rotate-90" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2.5 7.5 6 4 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="flex-1">{label}</span>
            <span class="text-[11px] tabular-nums text-slate-500">{items.length}</span>
          </summary>
          <ul class="mt-0.5 mb-2 space-y-px">
            {items.map((t) => {
              const Icon = t.icon;
              const active = current?.id === t.id;
              return (
                <li>
                  <a
                    href={t.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2 rounded py-1 pl-6 pr-2 text-[13px] transition-colors',
                      active
                        ? 'bg-indigo-500/12 text-white shadow-[inset_2px_0_0_var(--color-ws-accent)]'
                        : 'text-slate-400 hover:bg-slate-900 hover:text-slate-200',
                    ]}
                  >
                    <Icon class={`h-3.5 w-3.5 shrink-0 ${t.color}`} aria-hidden="true" />
                    <span class="truncate">{shortName(t)}</span>
                    {t.status === 'New' && <span class="ml-auto shrink-0 text-[10px] font-medium text-indigo-400">new</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </details>
      );
    })}
  </div>

  <div class="space-y-3 border-t border-slate-800 p-3">
    <AdSlot toolId={current?.id} category={current?.category} />
    <a href={HIRE_URL} target="_blank" rel="noopener" class="block rounded-lg bg-slate-900 p-3 text-xs leading-relaxed text-slate-400 hover:text-slate-300">
      <span class="block text-[13px] font-medium text-slate-200">Need a custom converter?</span>
      Digitek Lab builds internal tools and API integrations.
    </a>
  </div>
</nav>
