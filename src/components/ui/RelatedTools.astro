---
// src/components/ui/RelatedTools.astro
// Same-category tools first, then the most-used tools, so every page links
// into its topic cluster and into the high-traffic pages.
import { TOOLS, FEATURED_TOOL_IDS, CATEGORY_NAV, type Tool } from '../../config/tools';
import ToolCard from './ToolCard.astro';

interface Props { currentTool: string }
const { currentTool } = Astro.props;
const current = TOOLS.find((t) => t.id === currentTool);
const others = TOOLS.filter((t) => t.id !== currentTool);
const sameCat = others.filter((t) => t.category === current?.category);
const featured = FEATURED_TOOL_IDS.map((id) => others.find((t) => t.id === id)).filter(Boolean) as Tool[];
const picks: Tool[] = [];
for (const t of [...sameCat.slice(0, 4), ...featured, ...others]) {
  if (!picks.includes(t)) picks.push(t);
  if (picks.length === 6) break;
}
const label = CATEGORY_NAV.find((c) => c.key === current?.category)?.label;
---

<section class="mt-16 border-t border-slate-800 pt-10">
  <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-xl font-semibold text-white">Related tools</h2>
    {current && <a href={`/tools/category/${current.category}`} class="text-sm text-indigo-400 hover:text-indigo-300">All {label} tools</a>}
  </div>
  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
    {picks.map((tool) => <ToolCard tool={tool} />)}
  </div>
</section>
