---
// src/components/ui/Footer.astro
import { CATEGORY_NAV, FEATURED_TOOL_IDS, toolById, shortName, TOOLS } from '../../config/tools';
import { EXTENSION_URL, HIRE_URL } from '../../config/site';

const featured = FEATURED_TOOL_IDS.map((id) => toolById(id)).filter(Boolean);
---

<footer class="border-t border-slate-800 bg-ws-rail">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-8 gap-y-10 px-4 py-12 md:grid-cols-4">
    <div class="col-span-2 md:col-span-1">
      <a href="/" class="text-[17px] font-semibold tracking-tight text-white no-underline">Syntax<span class="text-indigo-500">Snap</span></a>
      <p class="mt-3 max-w-[28ch] text-sm leading-relaxed text-slate-400">
        {TOOLS.length} developer tools that run in your browser. Paste production data without sending it anywhere.
      </p>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-medium text-slate-200">Popular</h2>
      <ul class="space-y-2 text-sm text-slate-400">
        {featured.map((t) => <li><a href={t!.href} class="hover:text-white">{shortName(t!)}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-medium text-slate-200">Categories</h2>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href="/tools" class="hover:text-white">All tools</a></li>
        {CATEGORY_NAV.map((c) => <li><a href={`/tools/category/${c.key}`} class="hover:text-white">{c.label}</a></li>)}
        <li><a href="/cheatsheets/regex" class="hover:text-white">Regex cheatsheet</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-3 text-sm font-medium text-slate-200">SyntaxSnap</h2>
      <ul class="space-y-2 text-sm text-slate-400">
        <li><a href={EXTENSION_URL} target="_blank" rel="noopener noreferrer" class="hover:text-white">Chrome extension</a></li>
        <li><a href="/offline" class="hover:text-white">Self-hosting for teams</a></li>
        <li><a href="/sponsor" class="hover:text-white">Sponsor</a></li>
        <li><a href={HIRE_URL} target="_blank" rel="noopener" class="hover:text-white">Hire us for custom tools</a></li>
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-800">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 pb-12 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} SyntaxSnap. Built in Cuddalore by <a href="https://digiteklab.com" target="_blank" rel="noopener" class="text-slate-400 hover:text-white">Digitek Lab</a>.</p>
      <p class="flex gap-5"><a href="/privacy" class="hover:text-slate-300">Privacy</a><a href="/terms" class="hover:text-slate-300">Terms</a></p>
    </div>
  </div>
</footer>
