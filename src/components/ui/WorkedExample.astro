---
// src/components/ui/WorkedExample.astro — one input → output example on a tool page.
interface Props {
  title?: string;
  input: string;
  output: string;
  inputLabel?: string;
  outputLabel?: string;
}
const { title = 'Worked example', input, output, inputLabel = 'Input', outputLabel = 'Output' } = Astro.props;
---

<section class="mt-12" aria-labelledby="worked-example">
  <h2 id="worked-example" class="text-[1.375rem] font-semibold tracking-tight text-white">{title}</h2>
  <div class="mt-2 max-w-[72ch] text-[15px] leading-relaxed text-slate-400"><slot /></div>
  <div class="mt-4 grid gap-3 md:grid-cols-2">
    <figure class="min-w-0 overflow-hidden rounded-lg border border-slate-800 bg-ws-panel">
      <figcaption class="border-b border-slate-800 px-3 py-1.5 text-[12.5px] font-medium text-slate-400">{inputLabel}</figcaption>
      <pre class="overflow-x-auto p-3 font-mono text-[12.5px] leading-relaxed text-slate-200"><code>{input}</code></pre>
    </figure>
    <figure class="min-w-0 overflow-hidden rounded-lg border border-slate-800 bg-ws-panel">
      <figcaption class="border-b border-slate-800 px-3 py-1.5 text-[12.5px] font-medium text-slate-400">{outputLabel}</figcaption>
      <pre class="overflow-x-auto p-3 font-mono text-[12.5px] leading-relaxed text-slate-200"><code>{output}</code></pre>
    </figure>
  </div>
</section>
