---
// src/components/ui/HowToSection.astro
import type { HowTo } from '../../data/seo/types';
interface Props { howTo?: HowTo }
const { howTo } = Astro.props;
---

{howTo && howTo.steps && howTo.steps.length > 0 && (
  <section class="mt-14 border-t border-slate-800 pt-10">
    <h2 class="mb-5 text-xl font-semibold text-white">{howTo.name}</h2>
    <ol class="grid max-w-4xl gap-3 md:grid-cols-3">
      {howTo.steps.map((step, index) => (
        <li class="rounded-lg border border-slate-800 bg-ws-panel p-4">
          <span class="font-mono text-xs text-indigo-400">Step {index + 1}</span>
          <h3 class="mt-1 text-[15px] font-medium text-slate-100">{step.name}</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-400">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>
)}
