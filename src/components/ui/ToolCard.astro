---
// src/components/ui/ToolCard.astro
import type { Tool } from '../../config/tools';

interface Props { tool: Tool }
const { tool } = Astro.props;
const Icon = tool.icon;
---

<a href={tool.href} class="group flex gap-3 rounded-lg border border-slate-800 bg-ws-panel p-4 transition-colors hover:border-slate-700 hover:bg-ws-raised">
  <span class={`mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-md ${tool.bg} ${tool.color}`}>
    <Icon class="h-4 w-4" aria-hidden="true" />
  </span>
  <span class="min-w-0">
    <span class="flex items-baseline gap-2">
      <span class="text-[15px] font-medium text-white group-hover:text-indigo-300">{tool.title}</span>
      {tool.status !== 'Live' && (
        <span class={`text-[11px] font-medium ${tool.status === 'New' ? 'text-indigo-400' : 'text-slate-400'}`}>{tool.status.toLowerCase()}</span>
      )}
    </span>
    <span class="mt-1 line-clamp-2 block text-[13px] leading-relaxed text-slate-400">{tool.desc}</span>
  </span>
</a>
