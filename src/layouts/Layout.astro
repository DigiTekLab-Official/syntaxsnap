---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro'; 
import CommandPalette from '../components/ui/CommandPalette.tsx';
import Explorer from '../components/workspace/Explorer.astro';
import StatusBar from '../components/workspace/StatusBar.astro';
import ExtensionStrip from '../components/workspace/ExtensionStrip.astro';
import { toolById, CATEGORY_NAV } from '../config/tools';

interface Props {
  title?: string;
  description?: string;
  isTool?: boolean; 
  features?: string[]; 
  faqs?: { question: string; answer: string }[]; 
  howTo?: { name: string; steps: { name: string; text: string }[] }; 
  slug?: string; 
  isHomepage?: boolean;
}

const { 
  title = "SyntaxSnap - Privacy-First Developer Tools",
  description = "A privacy-first suite of developer tools that run entirely in your browser. No servers. No tracking.",
  isTool = false,
  features,
  faqs,
  howTo,
  slug, 
  isHomepage = false,
} = Astro.props;

// ── 1. STRICT CANONICAL URL LOGIC (Cloudflare Pages Safe) ─────────
const siteUrl = Astro.site ? new URL(Astro.site).origin : "https://syntaxsnap.com";
let pathname = Astro.url.pathname;

if (pathname !== '/' && pathname.endsWith('/')) {
  pathname = pathname.slice(0, -1);
}
if (pathname.endsWith('.html')) {
  pathname = pathname.slice(0, -5);
}
// build.format 'file' renders the homepage as /index; its canonical is the root.
if (pathname === '/index' || pathname === '') {
  pathname = '/';
}

// ── Workspace context for tool pages ──────────────────────────────
const tool = isTool && slug ? toolById(slug) : undefined;
const toolCategory = tool ? CATEGORY_NAV.find((c) => c.key === tool.category) : undefined;

const canonicalURL = new URL(pathname, siteUrl).toString();

// ── 2. DYNAMIC OG IMAGE ───────────────────────────────────────────
const ogImagePath = slug ? `/og/${slug}.png` : '/og-preview.jpg';
const socialImageURL = new URL(ogImagePath, siteUrl).toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
    <link rel="preconnect" href="https://c.clarity.ms" crossorigin />
    <link rel="preconnect" href="https://c.bing.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://c.clarity.ms" />
    <link rel="dns-prefetch" href="https://c.bing.com" />
    
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <meta name="theme-color" content="#0c121d" />
    <link rel="preload" href="/fonts/plex-sans-var.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SyntaxSnap" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    {/* SEO Schema: Now properly passing all rich snippet data */}
    <JsonLd 
      type={isTool ? 'tool' : 'website'} 
      title={title} 
      description={description} 
      url={canonicalURL} 
      features={features}
      faqs={faqs}
      howTo={howTo}      
    />
  </head>
  
  <body class="flex min-h-screen flex-col bg-ws-bg font-sans text-slate-200 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[60] focus:rounded focus:bg-indigo-500 focus:px-3 focus:py-2 focus:text-slate-950">Skip to content</a>
    <Header />

    {tool ? (
      <div class="flex flex-1">
        <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem-1.75rem)] w-[264px] shrink-0 border-r border-slate-800 bg-ws-rail lg:block">
          <Explorer current={tool} />
        </aside>

        {/* data-clarity-mask: Clarity session recordings and heatmaps must never capture what
            people paste into a tool or the output it produces. Clicks and scrolls are still recorded. */}
        <main id="main" class="min-w-0 flex-1 px-4 pb-16 pt-5 md:px-8" data-clarity-mask="True">
          <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-1.5 text-[13px] text-slate-500">
            <a href="/" class="hover:text-slate-200">Home</a>
            <span aria-hidden="true">/</span>
            <a href={`/tools/category/${tool.category}`} class="hover:text-slate-200">{toolCategory?.label}</a>
            <span aria-hidden="true">/</span>
            <span class="text-slate-300" aria-current="page">{tool.short ?? tool.title}</span>
          </nav>

          <slot />

          <ExtensionStrip tool={tool} />
        </main>
      </div>
    ) : (
      <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 pb-16 pt-8 md:pt-12">
        {Astro.slots.has('breadcrumb') && (
          <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-sm text-slate-500">
            <slot name="breadcrumb" />
          </nav>
        )}
        <slot />
      </main>
    )}

    <Footer />

    {/* Analytics */}
    <!-- Google Analytics + Microsoft Clarity: production hostname only, so local dev,
         Playwright/Lighthouse runs and *.pages.dev previews don't pollute the data. -->
    <script is:inline>
      (function () {
        var h = location.hostname;
        if (h !== 'syntaxsnap.com' && h !== 'www.syntaxsnap.com') return;
        var g = document.createElement('script');
        g.async = true;
        g.src = 'https://www.googletagmanager.com/gtag/js?id=G-QCZWS74HCP';
        document.head.appendChild(g);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-QCZWS74HCP');
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', 'viplajyvf3');
      })();
    </script>
    <StatusBar tool={tool} />
    <CommandPalette client:idle />
  </body>
</html>